# Local development only. Copy to backend/.env and keep that file untracked.

# Application
APP_ENV=development
DEBUG=false
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Database and queue
DATABASE_URL=postgresql+asyncpg://peaktalk_local:local-only-password@localhost:5432/peaktalk_local
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
REDIS_URL=redis://localhost:6379/0

# Better Auth service hosted by the frontend
BETTER_AUTH_SESSION_URL=http://localhost:3000/api/auth/get-session
BETTER_AUTH_API_URL=http://localhost:3000/api/auth

# Billing is deliberately disabled in the review/local environment.
PAYMENTS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_SEND_RECEIPT=false

# Optional AI-compatible endpoint. The application starts without it.
CLOUD_RU_API_KEY=
CLOUD_RU_BASE_URL=http://localhost:8080/v1
CLOUD_RU_MODEL=local-placeholder-model
AI_DETECTION_LLM_ENABLED=false

# Optional S3-compatible storage. Replace only for a local development service.
STORAGE_PROVIDER=yandex
YANDEX_S3_ENDPOINT_URL=http://localhost:9000
YANDEX_S3_REGION=local
YANDEX_S3_BUCKET=local-placeholder-bucket
YANDEX_S3_KMS_KEY_ID=
YANDEX_S3_ACCESS_KEY_ID=placeholder
YANDEX_S3_SECRET_ACCESS_KEY=placeholder

# Push notifications are disabled while these values are empty.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:notifications@localhost

# Optional outbound mail and administration.
EMAIL_FROM_ADDRESS=PeakTalk Local <noreply@localhost>
RESEND_API_KEY=
ADMIN_EMAILS=
BETTER_AUTH_BOOTSTRAP_ADMIN_EMAIL=
