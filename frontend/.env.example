# Local development only. Copy to frontend/.env.local and keep that file untracked.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_HCAPTCHA_SITEKEY=local-disabled-placeholder
NEXT_PUBLIC_METRIKA_ID=

# Better Auth uses the same local PostgreSQL instance as the backend.
BETTER_AUTH_DATABASE_URL=postgresql://peaktalk_local:local-only-password@localhost:5432/peaktalk_local
BETTER_AUTH_SECRET=local-development-placeholder-change-before-deployment
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# For `npm run dev`, start `node scripts/dev-auth-mail-capture.mjs` separately.
AUTH_MAIL_CAPTURE_URL=http://localhost:8025/messages
EMAIL_FROM_ADDRESS=PeakTalk Local <noreply@localhost>
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=1025
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
RESEND_API_KEY=
